# Reddit script app. Required for live post ids. Not required for post id "demo".
# Create one at https://www.reddit.com/prefs/apps (type: script).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=karmamining comment scorer

# Legacy names still accepted by the API process: client_secret, reddit_password.

# JSONL training file with {"body", "score"} rows. Defaults to the bundled sample.
# DATA_FILE=data/sample_comments.jsonl

# PORT=8080

# Only used by elastic.py, which is not part of the web app.
# ELASTICSEARCH_URL=https://example.us-west-1.es.amazonaws.com
# ELASTICSEARCH_COMMENTS_FILE=data2.txt
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
